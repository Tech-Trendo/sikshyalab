# Media — S3-compatible DataHub (hybrid: PG stores keys only; binaries in S3)
USE_S3=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# DataHub / S3 API endpoint, e.g. https://s3-np1.datahub.com.np
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_SIGNATURE_VERSION=s3v4
# Leave empty for ACL-disabled buckets (DataHub / Bucket owner enforced)
AWS_DEFAULT_ACL=
AWS_QUERYSTRING_AUTH=true
AWS_QUERYSTRING_EXPIRE=900
AWS_S3_FILE_OVERWRITE=false
# Optional key prefix inside the bucket (e.g. ShikshaLab). DB keys stay unprefixed.
AWS_LOCATION=

# Media streaming cookie (httpOnly) — set at login; used by /content/resources/<id>/stream/
# SameSite=Lax works same-site (localhost:5173→:8000). Cross-origin LAN (different IP)
# cannot use cookies without SameSite=None + Secure (HTTPS). On HTTP LAN, /stream/
# also accepts Authorization: Bearer; SPA must fetch with that header (not bare <video src>).
MEDIA_COOKIE_NAME=sl_media_session
MEDIA_COOKIE_SAMESITE=Lax
# true in production (HTTPS). false for local http://localhost
MEDIA_COOKIE_SECURE=false
MEDIA_COOKIE_MAX_AGE=3600
CORS_ALLOW_CREDENTIALS=true
# For production cross-site SPA→API over HTTPS, use:
# MEDIA_COOKIE_SAMESITE=None
# MEDIA_COOKIE_SECURE=true

# Optional local Redis for Celery (install Redis on the host; not via Docker)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

VIDEO_CRF=23
VIDEO_PRESET=medium
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
AUDIO_BITRATE=128k
# Cap output height (720 recommended for course streaming; use 1080 for higher quality)
VIDEO_MAX_HEIGHT=720
# Keep uncompressed original after compression (true) or delete it (false)
VIDEO_KEEP_ORIGINAL=true
VIDEO_MAX_BYTES=262144000
VIDEO_DOWNLOAD_URL_EXPIRY_SECONDS=3600
VIDEO_UPLOAD_TMP_DIR=

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Google reCAPTCHA — site key is public; secret must NEVER be committed or exposed to the frontend.
# Leave both empty to disable verification (local/dev).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# v3 only (0 = off; use checkbox v2 without a score gate)
RECAPTCHA_MIN_SCORE=0

# Public Next.js site (canonical URLs in sitemap XML + JSON)
FRONTEND_URL=http://localhost:8081
# Django API origin (sitemap index loc host in production)
SITE_URL=http://localhost:8000
# Max URLs per sitemap.xml file (Google limit is 50000)
SITEMAP_MAX_URLS=50000

# Comma-separated Next.js / dashboard origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

