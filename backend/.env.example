# =============================================================================
# ShikshaLab backend — copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Core (required for production) -----------------------------------------
# Use config.settings.production on the VPS (never leave development defaults).
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
# Generate a fresh key for production (do not reuse local):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-in-production-shikshalab
# Hosts only — no scheme. Never use * in production.
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins with scheme (https://…). Required for admin / session CSRF.
CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL) --------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=shikshalab
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# --- Public URLs (set real https://… values on VPS) -------------------------
FRONTEND_URL=http://localhost:8081
SITE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:3000
SITEMAP_MAX_URLS=50000

# Comma-separated SPA origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# Seed / bootstrap only — change before first seed on any shared or prod DB
SUPERADMIN_EMAIL=admin@shikshalab.io
SUPERADMIN_PASSWORD=change-me-before-seed

# --- HTTPS / cookies (production) -------------------------------------------
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
MEDIA_COOKIE_NAME=sl_media_session
MEDIA_COOKIE_SAMESITE=Lax
# true in production (HTTPS). false for local http://localhost
MEDIA_COOKIE_SECURE=false
MEDIA_COOKIE_MAX_AGE=3600
# For production cross-site SPA→API over HTTPS, use:
# MEDIA_COOKIE_SAMESITE=None
# MEDIA_COOKIE_SECURE=true

# --- Redis (required in production: cache + Channels + Celery) --------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- Media — S3-compatible DataHub (or set USE_S3=false for local disk) -----
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# DataHub / S3 API endpoint, e.g. https://s3-np1.datahub.com.np
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_SIGNATURE_VERSION=s3v4
# Leave empty for ACL-disabled buckets (DataHub / Bucket owner enforced)
AWS_DEFAULT_ACL=
AWS_QUERYSTRING_AUTH=true
AWS_QUERYSTRING_EXPIRE=900
AWS_S3_FILE_OVERWRITE=false
# Optional key prefix inside the bucket (e.g. ShikshaLab). DB keys stay unprefixed.
AWS_LOCATION=

# --- Video / ffmpeg ---------------------------------------------------------
VIDEO_CRF=23
VIDEO_PRESET=medium
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
AUDIO_BITRATE=128k
VIDEO_MAX_HEIGHT=720
VIDEO_KEEP_ORIGINAL=true
VIDEO_MAX_BYTES=262144000
VIDEO_DOWNLOAD_URL_EXPIRY_SECONDS=3600
VIDEO_UPLOAD_TMP_DIR=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- reCAPTCHA (optional; leave empty to disable) ---------------------------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0

# --- Optional ops -----------------------------------------------------------
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# THROTTLE_ANON=100/hour
# THROTTLE_USER=1000/hour
# ENABLE_DEBUG_TOOLBAR=false
