# =============================================================================
# ShikshaLab Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings
# Development: * allows phone/LAN access (e.g. 192.168.x.x). Production: list real domains only.
ALLOWED_HOSTS=*
DJANGO_LOG_LEVEL=INFO

# Database — PostgreSQL required
DB_ENGINE=django.db.backends.postgresql
DB_NAME=shikshalab
DB_USER=shikshalab
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_ALL_ORIGINS=True
FRONTEND_URL=http://localhost:8081
SUPERADMIN_EMAIL=admin@shikshalab.io
SUPERADMIN_PASSWORD=Admin@12345

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email — for real inbox delivery
# Easiest: Brevo API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Or SMTP (use a reachable host; many cPanel "agni.*" hosts block/timeout remotely):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=


# Uploads (local MEDIA_ROOT when USE_S3=false; otherwise S3/DataHub bucket)
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_DOCUMENT_BYTES=20971520
MEDIA_MAX_VIDEO_BYTES=209715200
MEDIA_MAX_UPLOAD_BYTES=20971520

# S3-compatible object storage (DataHub / MinIO / AWS)
# PostgreSQL stores only text + file keys; binaries go to the bucket when USE_S3=true
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_DEFAULT_ACL=
AWS_LOCATION=
AWS_QUERYSTRING_AUTH=true
AWS_QUERYSTRING_EXPIRE=3600
AWS_S3_FILE_OVERWRITE=false

# Production security (used by config.settings.production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Debug toolbar (development only)
ENABLE_DEBUG_TOOLBAR=False

# Partner sync — external catalog mirrored into local Partner table every N days
# Leave PARTNER_SYNC_API_URL empty to disable remote fetches (task will no-op / error safely)
PARTNER_SYNC_API_URL=
PARTNER_SYNC_API_TOKEN=
PARTNER_SYNC_API_TIMEOUT_SECONDS=30
PARTNER_SYNC_INTERVAL_DAYS=30
