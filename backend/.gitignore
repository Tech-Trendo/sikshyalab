# =============================================================================
# ShikshaLab — .gitignore
# =============================================================================

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
ENV/
env/
.env/
.virtualenv/

# Environment & secrets
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# Django
*.log
db.sqlite3
db.sqlite3-journal
sqlite_data_backup.json
media/
!media/.gitkeep
.test_media/
staticfiles/
local_settings.py

# Logs
logs/*
!logs/.gitkeep

# Durable local runtime state (partner sync timestamp, etc.)
var/
!logs/.gitkeep

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Testing / coverage
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.pytest_cache/
.hypothesis/
coverage.xml
*.cover
.cache/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# IDE / editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Celery
celerybeat-schedule
celerybeat.pid

# Legacy ignore (Docker removed from this project)
docker-compose.override.yml
Dockerfile
docker-compose.yml

# Misc
*.bak
*.tmp
*.temp
.ipynb_checkpoints/
