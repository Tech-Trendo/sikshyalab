# Local development defaults (copy to .env or .env.local and adjust).
# For LAN backend, set the host to your machine IP instead of 127.0.0.1.

VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_DJANGO_ORIGIN=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/notifications/
VITE_WEB_URL=http://localhost:8081

# Optional: LAN IP when frontend and backend run on different machines
# VITE_LAN_HOST=192.168.x.x

# --- Production on VPS (see .env.production; bake in at `npm run build`) ---
# VITE_API_URL=https://app.shikshalab.com/api/v1
# VITE_DJANGO_ORIGIN=https://app.shikshalab.com
# VITE_WS_URL=wss://app.shikshalab.com/ws/notifications/
# VITE_WEB_URL=https://shikshalab.com
