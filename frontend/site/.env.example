# Local development defaults (copy to .env.local and adjust).

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_DJANGO_ORIGIN=http://127.0.0.1:8000
API_PROXY_TARGET=http://127.0.0.1:8000

NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5173
NEXT_PUBLIC_SITE_URL=http://localhost:8081

# Optional: LAN IP when frontend and backend run on different machines
# NEXT_PUBLIC_LAN_HOST=192.168.x.x

# Google reCAPTCHA v2 ("I'm not a robot") — public site key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google Analytics 4 Measurement ID (public)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# --- Production on VPS (see also .env.production; set before `npm run build`) ---
# NEXT_PUBLIC_API_URL=https://app.shikshalab.com/api/v1
# NEXT_PUBLIC_DJANGO_ORIGIN=https://app.shikshalab.com
# API_PROXY_TARGET=https://app.shikshalab.com
# NEXT_PUBLIC_DASHBOARD_URL=https://dash.shikshalab.com
# NEXT_PUBLIC_SITE_URL=https://shikshalab.com
